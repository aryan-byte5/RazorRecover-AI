# ==============================================================================
# RazorRecover AI — Production & Development Environment Configuration
# ==============================================================================

# ==========================================
# 1. DATABASE CONNECTIVITY (MySQL / PostgreSQL / SQLite)
# ==========================================

# OPTION A: MySQL Database (Recommended for MySQL Production Environments)
# Formats supported: Local MySQL 8.0, AWS RDS MySQL, PlanetScale, Aiven, Railway
DATABASE_URL="mysql://root:password@localhost:3306/razorrecover?sslmode=prefer"
# For PlanetScale / SSL-required MySQL:
# DATABASE_URL="mysql://username:password@aws.connect.psdb.cloud/razorrecover?sslaccept=strict"

# OPTION B: PostgreSQL (Neon / Supabase / AWS RDS PostgreSQL)
# DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# OPTION C: Local SQLite (Zero-Config Development File)
# DATABASE_URL="file:./dev.db"

# ==========================================
# 2. AUTHENTICATION & SECURITY
# ==========================================
# High-entropy JWT secret key for signing session tokens
JWT_SECRET="replace-with-a-secure-random-64-char-string-in-production"

# Environment mode ('development' or 'production')
NODE_ENV="development"

# ==========================================
# 3. PUBLIC APP URL
# ==========================================
# Public HTTPS URL of the deployed application (e.g., https://razorrecover-ai.vercel.app)
NEXT_PUBLIC_APP_URL="https://razorrecover-ai.vercel.app"

# ==========================================
# 4. OPTIONAL AI MODEL PROVIDER KEYS
# ==========================================
# Optional: Google Gemini API Key (gemini-1.5-flash)
GEMINI_API_KEY=""

# Optional: OpenAI API Key (gpt-4o)
OPENAI_API_KEY=""

# Note: If no LLM keys are supplied, RazorRecover AI runs autonomously using its
# built-in Deterministic Fintech Expert Engine with full diagnostic accuracy!

# ==========================================
# 5. GATEWAY & WEBHOOK INTEGRATIONS
# ==========================================
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_key_2026"
